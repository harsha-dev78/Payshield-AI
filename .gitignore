# ==============================================================================
# PayShield AI - Comprehensive .gitignore
# ==============================================================================

# Node & Package Manager Dependencies
node_modules/
.npm/
.pnpm-store/
package-lock.json.bak

# Build & Compilation Outputs
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Environment & Sensitive Credentials
# Explicitly ignore all .env files across all directories except .env.example
.env
.env.*
*.env
!.env.example
!server/.env.example

# Local SQLite Databases & WAL Cache Files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
payshield.db*
server/payshield.db*

# Test Coverage & Tooling Caches
coverage/
.nyc_output/
.vitest/
.turbo/
.cache/

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE, OS & Editor Configuration
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
