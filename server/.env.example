# ==============================================================================
# PayShield AI Server - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `server/.env` before starting the backend service.
# NEVER commit your actual `.env` file containing real credentials to Git!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# PayPal Sandbox Credentials (https://developer.paypal.com/dashboard/)
# Leave placeholders to run in offline zero-dependency demo mock mode.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Risk Engine Thresholds (0 - 100 score range)
RISK_THRESHOLD_ALLOW=30
RISK_THRESHOLD_REVIEW=65
