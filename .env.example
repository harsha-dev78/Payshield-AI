# ==============================================================================
# PayShield AI - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `server/.env` (or project root `.env`) before starting.
# NEVER commit your actual `.env` file containing real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Network Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# PayPal Sandbox API Credentials
# ------------------------------------------------------------------------------
# 1. Sign in to https://developer.paypal.com/dashboard/
# 2. Navigate to: Apps & Credentials -> Sandbox
# 3. Create or select an App to obtain your Client ID and Client Secret
# 4. Note: If left with default placeholders, PayShield operates in offline
#    demo mock mode without calling external PayPal servers.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# Explainable Risk Engine Policy Thresholds
# ------------------------------------------------------------------------------
# Risk score ranges from 0 (lowest risk) to 100 (highest risk)
# - Scores < RISK_THRESHOLD_ALLOW are classified as ALLOW (Safe to capture)
# - Scores between ALLOW and REVIEW are classified as REVIEW (Needs manual check)
# - Scores > RISK_THRESHOLD_REVIEW are classified as BLOCK (Pre-capture interception)
# ------------------------------------------------------------------------------
RISK_THRESHOLD_ALLOW=30
RISK_THRESHOLD_REVIEW=65
